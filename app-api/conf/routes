# Routes
# This file defines the top-level application routes (higher priority first).
# ~~~~

# Health check
GET    /ping        controllers.ApplicationController.ping

# Member (email/password session auth)
POST   /member/api/signup    controllers.auth.SignupController.invoke
POST   /member/api/login     controllers.auth.LoginController.invoke
POST   /member/api/logout    controllers.auth.LogoutController.invoke
GET    /member/api/me        controllers.auth.GetMyProfileController.invoke

# Event (proposing, joining)
POST   /event/api/create     controllers.event.EventCreateController.invoke
